# ---------------------------------------------------------------------------
# Vorlage. `make setup` legt daraus die echte zugang.env an -- die wird NICHT
# eingecheckt (.gitignore), weil hier IPs, Benutzernamen und Key-Pfade drinstehen.
#
# Von Hand editieren geht auch; danach `make config` aufrufen, damit der
# ~/.ssh/config-Block neu geschrieben wird.
# ---------------------------------------------------------------------------

# --- Sprunghost (die Kiste, die durch die Firewall erreichbar ist) -----------
JUMP_ALIAS=systest
JUMP_HOST=198.51.100.10
JUMP_USER=ubuntu
JUMP_KEY=~/.ssh/systemtest_key

# --- Zielhost (die GPU-Instanz, nur ueber den Sprunghost erreichbar) ---------
# TARGET_HOST ist der Wert, der sich taeglich aendert -> `make ip`
TARGET_ALIAS=pinn
TARGET_HOST=203.0.113.20
TARGET_USER=student1
TARGET_KEY=~/.ssh/pinn-student

# --- Sonstiges ---------------------------------------------------------------
# Kommentar, der im eigenen Public Key steht. Der Chef erkennt daran, wem der
# Key gehoert.
KEY_COMMENT=vorname.nachname
