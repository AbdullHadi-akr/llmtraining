# Ignore everything by default
*

# Keep directories traversable so unignore rules can match files inside
!*/

# Keep only source notebooks and documentation
!*.py
!*.ipynb
!README
!README.*
!README_*.md
!ARCHITECTURE.md

# Keep the session handover notes tracked. Auch als .md: die Notiz vom 22.09.
# traegt Tabellen und Verweise, und .txt dafuer zu nehmen waere Formatpflege
# gegen eine Zeile Allowlist.
!UEBERGABE_*.txt
!UEBERGABE_*.md

# Keep training reports tracked
!TRAININGS_BERICHT_*.md
!**/TRAININGS_BERICHT_*.md

# Keep the roadmap tracked. It is the single entry point and deliberately NOT
# called README_*, so the allowlist above does not catch it.
!FAHRPLAN.md
!**/FAHRPLAN.md
!FAHRPLAN_*.md
!**/FAHRPLAN_*.md

# Keep the CI workflow tracked (the allowlist above is .py/.md only)
!.github/workflows/*.yml

# Keep the living benchmark tracked. Same reasoning as FAHRPLAN.md above: it is
# an entry point, deliberately NOT called README_*, so the allowlist does not
# catch it. The .jsonl next to it is the machine-readable trend of every run --
# it is small, append-only, and worthless outside the repo, so it goes in too.
!BENCHMARK.md
!**/BENCHMARK.md
!benchmark_runs.jsonl
!**/benchmark_runs.jsonl

# Keep the PINNmodulusTwo server setup files tracked (config + deps)
!PINNmodulusTwo/config.yaml
!PINNmodulusTwo/requirements-gpu.txt

# Same for the MPS systemd unit. README_GPU_SERVER.md 6.4 says to 'sudo cp' it
# into /etc/systemd/system/, and until 22.09. the allowlist above made that
# impossible: the instruction pointed at a file this repo could not carry, so it
# ran into the void. Vergessener MPS kostet Faktor 2.52, lautlos -- die Unit
# gehoert also versioniert und nicht in eine Zwischenablage.
!PINNmodulusTwo/deploy/nvidia-mps.service

# Same for the profile extension (its config.yaml IS the benchmark configuration)
!PINNmodulusTwoExtProfiles/config.yaml

# Keep this file tracked
!.gitignore

# Always ignore Python environments (including your physics venv)
.venv/
venv/
physics_env_fixed/
modulus_env/

# Always ignore data folders
processedData/
OP1/
/coordinates/
outputs/
storeOps/



# ---------------------------------------------------------------------------
# The simulation data. These rules come LAST on purpose: a directory that is
# itself ignored is never descended into, so the `!*.py` / `!README*` allowlist
# above cannot accidentally pull a file back out of these folders. They stay on
# your machine and on the GPU server (rsync), never in the repo.
# See PINNmodulusTwo/README_LOKALER_LAUF.md for what belongs in them.
# ---------------------------------------------------------------------------
data_cache/
material_properties/
